---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Footer from '../components/Footer.astro';
import CursorFollower from '../components/CursorFollower.astro';

// Import product data
import { collections, featuredProducts, allProducts } from '../data/products.js';

const showcaseItems = [
  {
    id: 1,
    title: 'Timeless Elegance',
    titleJp: '永遠の優雅さ',
    category: 'Spring 2024',
    description: 'Where tradition meets contemporary minimalism',
    image: '/images/showcase-1.jpg',
    products: featuredProducts.slice(0, 2)
  },
  {
    id: 2,
    title: 'Urban Heritage',
    titleJp: '都市の遺産',
    category: 'Urban Collection',
    description: 'Modern silhouettes rooted in craftsmanship',
    image: '/images/showcase-2.jpg',
    products: featuredProducts.slice(2, 4)
  },
  {
    id: 3,
    title: 'Artisan Soul',
    titleJp: '職人の魂',
    category: 'Heritage Line',
    description: 'Hand-finished pieces with timeless appeal',
    image: '/images/showcase-3.jpg',
    products: allProducts.slice(0, 2)
  },
  {
    id: 4,
    title: 'Minimal Form',
    titleJp: 'ミニマル形式',
    category: 'Essentials',
    description: 'Essential pieces for everyday luxury',
    image: '/images/showcase-4.jpg',
    products: allProducts.slice(2, 4)
  },
  {
    id: 5,
    title: 'Natural Flow',
    titleJp: '自然な流れ',
    category: 'Summer 2024',
    description: 'Breathable layers for warm seasons',
    image: '/images/showcase-5.jpg',
    products: allProducts.slice(4, 6)
  },
  {
    id: 6,
    title: 'Silent Strength',
    titleJp: '静かな強さ',
    category: 'Winter Collection',
    description: 'Refined warmth with understated power',
    image: '/images/showcase-6.jpg',
    products: allProducts.slice(6, 7)
  },
];

const stats = [
  { number: '2019', label: 'Established' },
  { number: `${allProducts.length}+`, label: 'Pieces Created' },
  { number: '12', label: 'Artisan Partners' },
  { number: '98%', label: 'Satisfaction Rate' },
];
---

<Layout title="Showcase - 和STYLE">
  <CursorFollower />
  <div data-scroll-container>
    <Header />
    <MobileMenu />

    <!-- Hero Section -->
    <section class="min-h-screen bg-black relative flex items-center justify-center overflow-hidden pt-20" data-scroll-section>
      <div class="absolute inset-0 bg-gradient-to-b from-zinc-900 via-black to-black"></div>
      <div class="grain"></div>
      
      <div class="container mx-auto px-6 lg:px-12 relative z-10">
        <div class="max-w-7xl mx-auto text-center">
          <div data-scroll data-scroll-speed="2">
            <p class="text-xs tracking-[0.3em] uppercase text-zinc-500 mb-8">
              Showcase Collection
            </p>
            <h1 class="text-6xl md:text-8xl lg:text-9xl font-black mb-8 jp-text leading-none">
              作品展示
            </h1>
            <p class="text-lg md:text-2xl text-zinc-400 max-w-3xl mx-auto">
              A curated selection of our finest work, showcasing the intersection of tradition and innovation
            </p>
          </div>

          <div class="mt-16 flex flex-wrap justify-center gap-4">
            <a href="/collection" class="px-8 py-4 border border-white/20 text-xs tracking-[0.2em] uppercase hover:bg-white hover:text-black transition-all duration-300">
              Explore Collection
            </a>
          </div>
        </div>
      </div>

      <!-- Scroll Indicator -->
      <div class="absolute bottom-12 left-1/2 -translate-x-1/2" data-scroll data-scroll-speed="-1">
        <div class="w-6 h-10 border border-white/30 rounded-full flex justify-center pt-2">
          <div class="w-1 h-3 bg-white/50 rounded-full scroll-indicator"></div>
        </div>
      </div>
    </section>

    <!-- Stats Section -->
    <section class="py-20 bg-zinc-950 border-y border-zinc-800" data-scroll-section>
      <div class="container mx-auto px-6 lg:px-12">
        <div class="max-w-7xl mx-auto">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
            {stats.map((stat, index) => (
              <div 
                class="text-center stat-item"
                data-scroll
                data-scroll-speed={0.5 + index * 0.1}
              >
                <h3 class="text-4xl md:text-5xl lg:text-6xl font-black mb-2">
                  {stat.number}
                </h3>
                <p class="text-xs md:text-sm text-zinc-500 tracking-wider uppercase">
                  {stat.label}
                </p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Showcase Grid -->
    <section class="py-24 md:py-32 bg-black" data-scroll-section id="showcase">
      <div class="container mx-auto px-6 lg:px-12">
        <div class="max-w-7xl mx-auto">
          <div class="mb-20" data-scroll data-scroll-speed="1">
            <p class="text-xs tracking-[0.3em] uppercase text-zinc-500 mb-4">Featured Work</p>
            <h2 class="text-5xl md:text-7xl lg:text-8xl font-black mb-6">
              Signature Pieces
            </h2>
            <p class="text-lg md:text-xl text-zinc-400 max-w-2xl">
              Each piece represents hours of dedicated craftsmanship and timeless design philosophy
            </p>
          </div>

          <!-- Masonry-style Grid -->
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
            {showcaseItems.map((item, index) => (
              <div 
                class={`showcase-card group ${index % 3 === 0 ? 'lg:row-span-2' : ''}`}
                data-scroll
                data-scroll-speed={0.3 + (index % 3) * 0.2}
              >
                <!-- Image Container -->
                <div class={`bg-zinc-900 mb-6 relative overflow-hidden ${index % 3 === 0 ? 'aspect-[3/5]' : 'aspect-[4/3]'}`}>
                  <!-- Product Image -->
                  {item.image && (
                    <img 
                      src={item.image} 
                      alt={item.title}
                      class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700"
                      loading="lazy"
                    />
                  )}
                  
                  <!-- Fallback Background -->
                  <div class="absolute inset-0 bg-gradient-to-br from-zinc-800 via-zinc-900 to-black"></div>
                  
                  <!-- Large Number -->
                  <div class="absolute inset-0 flex items-center justify-center">
                    <span class="text-9xl font-black text-white/5 group-hover:text-white/10 transition-all duration-700">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                  </div>

                  <!-- Category Badge -->
                  <div class="absolute top-6 left-6 px-4 py-2 bg-black/50 backdrop-blur-sm border border-white/10">
                    <p class="text-xs tracking-wider uppercase">{item.category}</p>
                  </div>

                  <!-- Hover Overlay -->
                  <div class="absolute inset-0 bg-black/70 opacity-0 group-hover:opacity-100 transition-all duration-500 flex items-center justify-center backdrop-blur-sm">
                    <div class="text-center space-y-4 px-6">
                      <a 
                        href="/collection"
                        class="inline-block px-6 py-3 border border-white/50 text-xs tracking-[0.2em] uppercase hover:bg-white hover:text-black transition-all duration-300"
                      >
                        View Details
                      </a>
                    </div>
                  </div>
                </div>

                <!-- Content -->
                <div class="space-y-3">
                  <div class="flex items-start justify-between gap-4">
                    <div class="flex-1">
                      <h3 class="text-xl md:text-2xl lg:text-3xl font-bold mb-2 group-hover:translate-x-2 transition-transform duration-300">
                        {item.title}
                      </h3>
                      <p class="text-base md:text-lg jp-text text-zinc-500 group-hover:text-zinc-400 transition-colors duration-300">
                        {item.titleJp}
                      </p>
                    </div>
                  </div>
                  
                  <div class="h-px bg-zinc-800 w-12 group-hover:w-24 group-hover:bg-white transition-all duration-500"></div>
                  
                  <p class="text-sm text-zinc-400 leading-relaxed group-hover:text-zinc-300 transition-colors duration-300">
                    {item.description}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="py-32 bg-zinc-950 relative overflow-hidden" data-scroll-section>
      <div class="absolute inset-0 bg-gradient-to-t from-black via-zinc-950 to-zinc-950"></div>
      
      <div class="container mx-auto px-6 lg:px-12 relative z-10">
        <div class="max-w-4xl mx-auto text-center">
          <div data-scroll data-scroll-speed="2">
            <h2 class="text-5xl md:text-7xl lg:text-8xl font-black mb-8 jp-text leading-tight">
              始めましょう
            </h2>
            <p class="text-lg md:text-xl text-zinc-400 mb-12 max-w-2xl mx-auto">
              Experience the perfect blend of traditional craftsmanship and modern design. 
              Discover pieces that tell your story.
            </p>

            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a 
                href="/collection"
                class="px-10 py-5 bg-white text-black text-sm tracking-[0.2em] uppercase hover:bg-zinc-200 transition-all duration-300 font-medium"
              >
                Browse Collection
              </a>
              <a 
                href="/"
                class="px-10 py-5 border border-white/20 text-sm tracking-[0.2em] uppercase hover:bg-white/5 transition-all duration-300"
              >
                Back to Home
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer Info -->
    <section class="py-20 bg-black border-t border-zinc-800" data-scroll-section>
      <div class="container mx-auto px-6 lg:px-12">
        <div class="max-w-7xl mx-auto">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
            <div data-scroll data-scroll-speed="0.5">
              <h4 class="text-xs tracking-[0.3em] uppercase text-zinc-500 mb-4">Philosophy</h4>
              <p class="text-sm text-zinc-400 leading-relaxed">
                Embracing imperfection and finding beauty in simplicity through mindful design.
              </p>
            </div>
            
            <div data-scroll data-scroll-speed="0.7">
              <h4 class="text-xs tracking-[0.3em] uppercase text-zinc-500 mb-4">Craftsmanship</h4>
              <p class="text-sm text-zinc-400 leading-relaxed">
                Every piece is crafted with traditional techniques passed down through generations.
              </p>
            </div>
            
            <div data-scroll data-scroll-speed="0.9">
              <h4 class="text-xs tracking-[0.3em] uppercase text-zinc-500 mb-4">Sustainability</h4>
              <p class="text-sm text-zinc-400 leading-relaxed">
                Using organic materials and ethical production to create lasting garments.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <Footer />
  </div>
</Layout>

<script>
  import gsap from 'gsap';

  window.addEventListener('load', () => {
    // Scroll indicator animation
    gsap.to('.scroll-indicator', {
      y: 10,
      duration: 1.5,
      ease: 'power2.inOut',
      repeat: -1,
      yoyo: true
    });

    // GSAP Hover interactions for showcase cards
    const showcaseCards = document.querySelectorAll('.showcase-card');
    
    showcaseCards.forEach((card) => {
      const number = card.querySelector('span');
      
      card.addEventListener('mouseenter', () => {
        if (number) {
          gsap.to(number, {
            scale: 1.1,
            rotation: 5,
            duration: 0.5,
            ease: 'power2.out'
          });
        }
      });
      
      card.addEventListener('mouseleave', () => {
        if (number) {
          gsap.to(number, {
            scale: 1,
            rotation: 0,
            duration: 0.5,
            ease: 'power2.out'
          });
        }
      });
    });
  });
</script>

<style>
  .showcase-card:hover {
    transform: translateY(-8px);
  }

  @media (max-width: 768px) {
    .showcase-card:hover {
      transform: none;
    }
  }
</style>